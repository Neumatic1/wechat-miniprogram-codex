.feedback-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.intro-card,
.form-card,
.tips-card {
  padding: 30rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.feedback-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #2e3b30;
}

.feedback-desc,
.tips-text {
  font-size: 24rpx;
  line-height: 1.7;
  color: #768176;
}

.form-section {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.field-label {
  font-size: 24rpx;
  color: #667165;
}

.field-textarea {
  width: 100%;
  min-height: 180rpx;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  background: #f7f2e8;
  font-size: 28rpx;
  color: #2c372d;
}

.upload-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.upload-count {
  font-size: 22rpx;
  color: #8a9288;
}

.screenshot-list {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.screenshot-item,
.screenshot-add {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 24rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.screenshot-item {
  background: #f1ebde;
}

.screenshot-image {
  width: 100%;
  height: 100%;
}

.screenshot-remove {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(37, 49, 39, 0.72);
  color: #ffffff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.screenshot-add {
  border: 2rpx dashed #c9d2c8;
  background: #fbf8f1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.screenshot-add-plus {
  font-size: 46rpx;
  color: #89a181;
}

.screenshot-add-text {
  font-size: 24rpx;
  color: #728071;
}

.feedback-submit {
  width: 100%;
  margin-top: 8rpx;
  box-sizing: border-box;
}
