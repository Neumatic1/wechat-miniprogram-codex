.detail-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.detail-hero,
.detail-actions,
.timeline-card {
  padding: 32rpx 28rpx;
}

.detail-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.detail-thumb {
  width: 116rpx;
  height: 116rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
  overflow: hidden;
}

.detail-thumb-image {
  width: 100%;
  height: 100%;
}

.detail-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.detail-name {
  font-size: 42rpx;
  font-weight: 700;
  color: #29352a;
}

.detail-template {
  font-size: 24rpx;
  color: #7d877c;
}

.detail-grid {
  margin-top: 28rpx;
  display: flex;
  flex-wrap: wrap;
  margin-left: -8rpx;
  margin-right: -8rpx;
}

.detail-metric {
  flex: 0 0 50%;
  width: 50%;
  box-sizing: border-box;
  padding: 0 8rpx 16rpx;
}

.detail-metric-inner {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #f7f2e8;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.metric-label {
  font-size: 22rpx;
  color: #7d877c;
}

.metric-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #304031;
}

.detail-progress {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.action-row {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.button-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: #efe8db;
  color: #5d695d;
  font-size: 28rpx;
}

.danger-button {
  background: #f8e1db;
  color: #b85c4b;
}

.timeline-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.timeline-item {
  display: flex;
  gap: 20rpx;
}

.timeline-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin-top: 10rpx;
  background: #8ea989;
  flex-shrink: 0;
}

.timeline-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.timeline-date {
  font-size: 22rpx;
  color: #7c857b;
}

.timeline-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #324032;
}

.timeline-detail {
  font-size: 24rpx;
  line-height: 1.6;
  color: #697268;
}
