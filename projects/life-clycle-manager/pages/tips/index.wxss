.tips-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.tips-card {
  padding: 30rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tips-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2d3b2f;
}

.tips-recommendation {
  font-size: 28rpx;
  line-height: 1.7;
  color: #546054;
}

.tips-authority {
  font-size: 26rpx;
  font-weight: 600;
  color: #5a7755;
}

.tips-body {
  font-size: 26rpx;
  line-height: 1.7;
  color: #5f6a60;
}

.tips-source-row {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tips-source-url {
  font-size: 22rpx;
  line-height: 1.6;
  color: #8a9288;
  word-break: break-all;
}

.tips-copy {
  align-self: flex-start;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #eef4e8;
  color: #68835d;
  font-size: 22rpx;
}
