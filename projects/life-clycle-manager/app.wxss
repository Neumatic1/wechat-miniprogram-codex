page {
  min-height: 100%;
  background: #f6f1e8;
  color: #253127;
  font-family: "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.page-shell {
  min-height: 100vh;
  padding: 32rpx 24rpx 40rpx;
  box-sizing: border-box;
}

.card {
  background: #fffdf8;
  border-radius: 28rpx;
  box-shadow: 0 16rpx 40rpx rgba(91, 112, 93, 0.08);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2d3b2f;
}

.section-subtitle {
  font-size: 24rpx;
  color: #7a8579;
  line-height: 1.6;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #efe8db;
  color: #637064;
  font-size: 24rpx;
  line-height: 1;
}

.chip-active {
  background: #8ea989;
  color: #ffffff;
}

.button-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: #8ea989;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}

.mini-ghost-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #eef4e8;
  color: #5f7758;
  font-size: 24rpx;
  font-weight: 600;
  align-self: flex-start;
}

.status-badge {
  align-self: flex-start;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1;
}

.status-normal {
  background: #e4f0de;
  color: #55804b;
}

.status-warning {
  background: #fff0d7;
  color: #ff8f1f;
}

.status-due_today,
.status-expired {
  background: #ffe0db;
  color: #e45d48;
}

.progress-track {
  width: 100%;
  height: 14rpx;
  border-radius: 999rpx;
  background: #eee7db;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
}

.progress-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 22rpx;
  color: #7b857a;
  gap: 18rpx;
}
