page {
  min-height: 100%;
  background:
    radial-gradient(circle at top left, rgba(217, 164, 65, 0.18), transparent 32%),
    linear-gradient(180deg, #101217 0%, #07080a 72%);
  color: #f5f2e8;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

view,
text,
button {
  box-sizing: border-box;
}

.page-shell {
  min-height: 100vh;
  padding: 32rpx 28rpx 180rpx;
}

.glass-card {
  border: 1rpx solid #3b3424;
  border-radius: 28rpx;
  background: rgba(23, 26, 33, 0.92);
  box-shadow: 0 20rpx 48rpx rgba(0, 0, 0, 0.28);
}

.page-title {
  display: block;
  font-size: 52rpx;
  line-height: 1.12;
  font-weight: 700;
  color: #f5f2e8;
}

.page-subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #c4bda8;
}

.pill-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 60rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid #3b3424;
  background: rgba(44, 36, 20, 0.9);
  color: #f2cc73;
  font-size: 24rpx;
  line-height: 1;
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(48, 39, 21, 0.9);
  color: #f0c967;
  font-size: 22rpx;
  line-height: 1;
}

.tag--muted {
  background: rgba(29, 33, 42, 0.92);
  color: #c4bda8;
}

.section-title {
  margin-bottom: 20rpx;
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 600;
  color: #f5f2e8;
}

.body-text {
  font-size: 26rpx;
  line-height: 1.7;
  color: #d7d0bf;
}

.muted-text {
  color: #8f8876;
}

.action-button {
  width: 100%;
  min-height: 84rpx;
  border-radius: 24rpx;
  border: 1rpx solid #3b3424;
  background: linear-gradient(135deg, #d9a441, #f2cc73);
  color: #111318;
  font-size: 28rpx;
  line-height: 84rpx;
  font-weight: 600;
}

.action-button--secondary {
  background: rgba(23, 26, 33, 0.92);
  color: #f5f2e8;
}
