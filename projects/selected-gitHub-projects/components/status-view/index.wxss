.status-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 44rpx 32rpx;
  text-align: center;
}

.status-view__mark {
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  border: 1rpx solid #3b3424;
  background: rgba(44, 36, 20, 0.96);
  color: #f2cc73;
  font-size: 56rpx;
  line-height: 64rpx;
}

.status-view__title {
  margin-top: 20rpx;
  color: #f5f2e8;
  font-size: 30rpx;
  font-weight: 600;
}

.status-view__description {
  margin-top: 14rpx;
  color: #c4bda8;
  font-size: 24rpx;
  line-height: 1.7;
}

.status-view__action {
  margin-top: 26rpx;
  min-width: 220rpx;
  min-height: 72rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid #3b3424;
  background: rgba(44, 36, 20, 0.96);
  color: #f2cc73;
  font-size: 24rpx;
  line-height: 72rpx;
}
