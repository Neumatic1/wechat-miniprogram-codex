.repo-card {
  padding: 28rpx;
}

.repo-card + .repo-card {
  margin-top: 24rpx;
}

.repo-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.repo-card__title-group {
  flex: 1;
  min-width: 0;
}

.repo-card__rank {
  display: inline-flex;
  align-items: center;
  margin-right: 12rpx;
  color: #f2cc73;
  font-size: 24rpx;
  font-weight: 700;
}

.repo-card__name {
  color: #f5f2e8;
  font-size: 32rpx;
  line-height: 1.3;
  font-weight: 600;
  word-break: break-all;
}

.repo-card__favorite {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 120rpx;
  min-height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid #3b3424;
  background: rgba(44, 36, 20, 0.96);
  color: #f2cc73;
  font-size: 22rpx;
}

.repo-card__summary {
  display: block;
  margin-top: 20rpx;
  color: #d7d0bf;
  font-size: 26rpx;
  line-height: 1.7;
}

.repo-card__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.repo-card__meta-item {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(29, 33, 42, 0.92);
  color: #c4bda8;
  font-size: 22rpx;
}

.repo-card__meta-item--accent {
  background: rgba(48, 39, 21, 0.96);
  color: #f0c967;
}

.repo-card__footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 24rpx;
}

.repo-card__copy {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid #2b2f38;
  color: #c4bda8;
  font-size: 22rpx;
  background: rgba(17, 19, 24, 0.92);
}
