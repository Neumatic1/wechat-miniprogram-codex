.hero,
.section {
  padding: 30rpx;
}

.section {
  margin-top: 24rpx;
}

.hero__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.hero__title-group {
  flex: 1;
  min-width: 0;
}

.hero__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.observable-banner {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
}

.observable-banner--info {
  border: 1rpx solid rgba(80, 102, 150, 0.48);
  background: rgba(25, 37, 60, 0.9);
}

.observable-banner--warning {
  border: 1rpx solid rgba(217, 164, 65, 0.5);
  background: rgba(58, 42, 12, 0.92);
}

.observable-banner__label {
  display: block;
  margin-bottom: 10rpx;
  color: #f2cc73;
  font-size: 22rpx;
  font-weight: 600;
}

.observable-banner__text {
  display: block;
  color: #efe4c8;
  font-size: 24rpx;
  line-height: 1.6;
}

.bullet-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.bullet-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.bullet-dot {
  width: 12rpx;
  height: 12rpx;
  margin-top: 14rpx;
  border-radius: 999rpx;
  background: #f2cc73;
  flex-shrink: 0;
}

.bullet-text {
  flex: 1;
}

.link-text {
  display: block;
  margin-bottom: 24rpx;
  word-break: break-all;
}

.detail-skeleton {
  height: 28rpx;
  margin-top: 18rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(43, 47, 56, 0.65), rgba(68, 73, 83, 0.9), rgba(43, 47, 56, 0.65));
}

.detail-skeleton--title {
  width: 76%;
  height: 40rpx;
  margin-top: 0;
}

.detail-skeleton--short {
  width: 44%;
}
